NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (preferred) or legacy anon key alias:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL for SEO, OG tags, sitemap (production)
# NEXT_PUBLIC_SITE_URL=https://wadeal-v2.vercel.app

# Optional: allow demo login on production (for QA until Kakao OAuth is ready)
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN=true

# Supabase project: ptbwemzxkmurwxbjaiwu
# Publishable key: Supabase → Settings → API Keys → Publishable key (sb_publishable_…)
#
# Kakao login via Supabase Auth (signInWithOAuth). Scopes: profile_nickname, profile_image.
# Kakao REST API key + client secret go in Supabase → Auth → Providers → Kakao (NOT in Vercel).
#
# Kakao Share (JavaScript SDK) — Kakao Developers → 앱 → 앱 키 → JavaScript 키
# NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# Kakao 채널 (고객센터 카카오톡 문의 링크)
# NEXT_PUBLIC_KAKAO_CHANNEL_URL=
#
# Toss Payments (결제 위젯 + 서버 승인) — server secret never expose to client
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
# Kakao (Supabase Auth provider — configure in Supabase dashboard, not Vercel):
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
# Optional webhook HMAC (payout/seller): TOSS_WEBHOOK_SECRET=
# Legacy aliases also supported: NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY, TOSS_PAYMENTS_SECRET_KEY
#
# Webhook URL (Supabase service role required for deposit callbacks):
# SUPABASE_SERVICE_ROLE_KEY=
#
# Referral visit IP hashing salt (server-only)
# REFERRAL_IP_SALT=
#
# Identity verification provider: mock | nice | pass | toss
# mock is dev-only; ignored in production (see docs/IDENTITY_VERIFICATION.md)
# IDENTITY_PROVIDER=mock
#
# Toss Payments Billing (server-only, group-buy auto-pay)
# TOSS_SECRET_KEY=
# TOSS_BILLING_MOCK=true
# CRON_SECRET=
#
# Supabase service role (server-only: webhooks, background jobs, error_logs insert)
# SUPABASE_SERVICE_ROLE_KEY=
#
# Sentry (optional — server-only error reporting when @sentry/nextjs is installed)
# SENTRY_DSN=
#
# Toss Payments (server-only unless noted)
# NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
# TOSS_PAYMENTS_SECRET_KEY=
# TOSS_PAYMENTS_WEBHOOK_SECRET=
#
# Public site URL for share links (optional; defaults to VERCEL_URL or localhost)
# NEXT_PUBLIC_SITE_URL=https://wadeal-v2.vercel.app
#
# Supabase → Auth → URL configuration → Redirect URLs:
#   http://localhost:3000/auth/callback
#   https://wadeal-v2.vercel.app/auth/callback
#
# Kakao Developers (와딜 app) → REST API key → Redirect URI:
#   https://ptbwemzxkmurwxbjaiwu.supabase.co/auth/v1/callback
