# Copy to `.env.local` (never commit `.env.local`).

# Supabase project URL (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (public, safe for browser; not the service role key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Without both variables above, the app uses mock data from lib/deals.ts.
